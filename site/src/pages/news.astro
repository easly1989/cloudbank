---
import Layout from "../layouts/Layout.astro";
import Ad from "../components/Ad.astro";

const REPO = "https://github.com/easly1989/cloudbank";

const releases = [
  {
    version: "Latest — smarter bank sync, review & bulk actions",
    date: "Ongoing",
    items: [
      "Bank imports are now reconciled against your existing manual and scheduled transactions — matched by amount and nearby date, a bank row is merged into what you already had instead of duplicated, imported with the right status (booked → reconciled, pending → cleared) and a default payment mode by account type.",
      "A new Review page completes imported transactions still missing a category and finds possible duplicates to merge, edit, delete, or mark \"not a duplicate\" (remembered so they don't come back).",
      "Bills redesigned to one row per bill — last payment and next occurrence — with a quick add-a-bill form; the register gains multi-select bulk edit/delete (category, payee, payment, status, tags) from the toolbar and right-click menu, with shift-click range selection.",
      "Dashboard edit mode gains Tidy (re-pack with no gaps) and Reset (default layout); CI adds CodeQL code scanning.",
    ],
  },
  {
    version: "Automatic bank sync",
    date: "Recent",
    items: [
      "Import transactions straight from your bank via SimpleFIN (worldwide) or Enable Banking (EU/EEA + UK, PSD2 open banking) — bring-your-own-credentials, so CloudBank never sees your bank login.",
      "New transactions are auto-categorised by your rules and refreshed automatically in the background; expiring EU consents surface a one-click reconnect.",
    ],
  },
  {
    version: "Security, the phone & AI",
    date: "Recent",
    items: [
      "Two-factor authentication (TOTP), scoped personal API tokens, and optional at-rest encryption of stored secrets (CB_SECRET_KEY).",
      "An installable PWA with an offline shell, plus opt-in web-push reminders for bills and schedules.",
      "Opt-in AI (bring-your-own-key): category suggestions and natural-language entry (\"coffee 3.50 yesterday\").",
    ],
  },
  {
    version: "Goals, bills & register",
    date: "Recent",
    items: [
      "Savings-goal piggy banks, and a Bills \"what's due\" view over your scheduled payments (scoped to your bills category).",
      "Full-text search across the register, and a right-click context menu on transactions (edit, duplicate, delete, mark cleared/reconciled, save as template).",
    ],
  },
  {
    version: "Dashboard & polish",
    date: "M11+",
    items: [
      "New dashboard widgets: net-worth trend, balance sparkline, spending calendar, category budget, currency rates, uncleared summary and a cashflow forecast.",
      "Security hardening: a strict Content-Security-Policy and safe attachment downloads.",
      "A per-account default payment mode, a running selection total in the register, and a per-week/month/year income & expense summary on Schedules.",
    ],
  },
  {
    version: "Personalization & interop",
    date: "M7–M10",
    items: [
      "A fully customisable, free-form dashboard — place, resize and add widgets anywhere.",
      "Native HomeBank .xhb export (round-trips with the importer), plus an accent-colour picker, collapsible sidebar and pinnable navigation.",
      "Templates management, a first-login tutorial, and this animated landing site.",
    ],
  },
  {
    version: "1.0.0",
    date: "2026-06-22",
    items: [
      "First public release: a self-hosted, web-based personal finance manager with HomeBank feature parity, shipped as a single Docker container.",
      "Accounts, a powerful register, scheduled transactions, budgets, a full suite of reports, and multi-format import (native .xhb, QIF, OFX/QFX, CSV).",
      "Multi-currency, multi-user, English + Italian, and interactive API docs.",
    ],
  },
];
---

<Layout page="news" title="News — CloudBank" description="What's new in CloudBank: release highlights and the changelog.">
  <section class="page-hero">
    <span class="eyebrow reveal">Changelog</span>
    <h1 class="reveal">News</h1>
    <p class="lead reveal">Release highlights. The full changelog lives in the repository.</p>
  </section>

  <section class="section">
    {
      releases.map((r) => (
        <div class="release reveal">
          <h3>{r.version}</h3>
          <div class="date">{r.date}</div>
          <ul>
            {r.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="hero-cta reveal" style="justify-content:center;margin-top:2rem">
      <a class="btn primary magnetic" href={`${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">Full changelog</a>
      <a class="btn magnetic" href={`${REPO}/releases`} target="_blank" rel="noopener">Releases</a>
    </div>
  </section>

  <Ad />
</Layout>
